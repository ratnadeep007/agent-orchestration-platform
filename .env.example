POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=agent_platform
DATABASE_URL=postgresql://app:app@postgres:5432/agent_platform

REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

OPENAI_API_KEY=

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
OPENCLAW_PUBLIC_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=local-dev-token
OPENCLAW_CONFIG_DIR=./.openclaw/config
OPENCLAW_WORKSPACE_DIR=./.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./.openclaw/auth-profile
OPENCLAW_CONFIG_PATH=/openclaw/config/openclaw.json
OPENCLAW_WORKSPACE_ROOT=/openclaw/workspace
OPENCLAW_CONTAINER_WORKSPACE_ROOT=/home/node/.openclaw/workspace
OPENCLAW_CONTAINER_AGENT_ROOT=/home/node/.openclaw/agents

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
